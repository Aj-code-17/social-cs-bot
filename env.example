# ============ META / FACEBOOK / INSTAGRAM ============
# Page access token from your Meta app (see README.md for setup steps)
PAGE_ACCESS_TOKEN=
# App Secret from Meta app dashboard (used to verify webhook signatures)
META_APP_SECRET=
# Any random string you invent — you'll paste the same one in Meta's webhook settings
VERIFY_TOKEN=change-me-to-a-long-random-string

# Which platforms to reply on: both | facebook | instagram
RESPOND_TO=both

# ============ LLM PROVIDER (choose one) ============
# openai | anthropic | gemini | offline
# "offline" = no API key needed, simple rule-based demo replies (great for testing)
LLM_PROVIDER=offline

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ============ BEHAVIOR ============
# Human-like pauses before replying (seconds)
MIN_DELAY_SECONDS=1.5
MAX_DELAY_SECONDS=4.0
# Wait this long to collect rapid-fire messages before replying (seconds)
DEBOUNCE_SECONDS=6
# When the bot flags a chat for a human, it goes quiet for this many minutes
HANDOFF_COOLDOWN_MINUTES=120
# Optional: POST handoff alerts to Slack/Discord/Zapier webhook
HANDOFF_WEBHOOK_URL=

# Path to business profile
BUSINESS_CONFIG=config/business.yaml
# Where chat history is stored
MEMORY_DB=conversations.db
